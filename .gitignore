# Ignore all files starting with .
.*
._*

# Do NOT ignore .gitignore
!.gitignore

# Do NOT ignore .distignore
!.distignore

# Do NOT ignore .gitignore
!.gitkeep

# Do NOT ignore .readme.md
!README.md

# Ignore all files that start with ~
~*

# Ignore packaged files
*.7z
*.csv
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
*.sql
*.tar.gz

# Ignore OS generated files
ehthumbs.db
Thumbs.db
.DS_Store

# Ignore log files
*.log

# Ignore lock files
*.lock

# Build Tools
.idea

# Projects specific
/gofolio
/gofolio.db
/init
/crush.db-wal
/crush.db-shm
/crush.db
/AGENTS.md
